DATABASE_URL="file:./vialservi.db"
API_PORT=4000
JWT_SECRET="cambiar-en-produccion-clave-larga"
CORS_ORIGIN="http://localhost:5173"

# ── Correo para la recuperacion de contrasena ──
# "consola" imprime el mensaje en el log del API: funciona sin credenciales y
# es lo que se usa en desarrollo y en la demostracion.
# "ses" o "resend" quedan listos para enchufar el proveedor cuando exista.
CORREO_MODO="consola"
CORREO_REMITENTE="no-responde@vialservi.co"

# Solo para desarrollo: devuelve el codigo en la respuesta HTTP para no tener
# que mirar el log. En produccion debe quedar en false, porque si no cualquiera
# que sepa un documento puede pedir el codigo y leerlo.
CORREO_REVELAR_CODIGO="true"

# Minutos de vida del codigo de recuperacion.
CODIGO_VIGENCIA_MINUTOS=15
