# ── Base de datos ─────────────────────────────────────────────────────────
# PostgreSQL. En local lo levanta docker-compose (npm run base:arriba); en AWS
# es el endpoint de RDS y esta cadena se arma en el arranque desde SSM.
DATABASE_URL="postgresql://vialservi:vialservi@127.0.0.1:5432/vialservi?schema=public"

# development | test | production
NODE_ENV="development"

# ── Servidor ──────────────────────────────────────────────────────────────
API_PORT=4000
# Lista separada por comas. En produccion el SPA comparte origen con el API
# (ambos detras de CloudFront), asi que esto solo hace falta en desarrollo.
CORS_ORIGIN="http://localhost:5173"

# Firma de las sesiones. En produccion NO se escribe aqui: se guarda en SSM
# Parameter Store y la plataforma la inyecta. Generar una con:
#   openssl rand -base64 48
JWT_SECRET="cambiar-en-produccion-clave-larga"

# ── AWS ───────────────────────────────────────────────────────────────────
AWS_REGION="us-east-1"

# Evidencias: "local" no sube nada y solo registra la referencia, que es lo que
# permite trabajar y hacer la demostracion sin cuenta de AWS. "s3" entrega URL
# prefirmadas para que el navegador suba directo al bucket.
ALMACENAMIENTO_MODO="local"
S3_BUCKET_EVIDENCIAS=""
S3_URL_MINUTOS=15

# ── Correo (recuperacion de contrasena) ───────────────────────────────────
#   consola : imprime el mensaje en el log del API. Sin credenciales.
#   ses     : Amazon SES. Una cuenta nueva solo envia a direcciones
#             verificadas hasta salir del "sandbox" (unas 24 horas).
#   smtp    : cualquier proveedor (Gmail, Brevo, SendGrid...). Envia a
#             CUALQUIER destinatario ya, verificando solo el remitente.
CORREO_MODO="consola"
CORREO_REMITENTE="no-responde@vialservi.co"

# Opcional: logo para la cabecera del correo. Si se deja vacio, la marca se
# dibuja con texto, que siempre se ve —la mayoria de los clientes de correo
# bloquean las imagenes hasta que el usuario las autoriza—.
CORREO_LOGO_URL=""

# ── SMTP (solo con CORREO_MODO=smtp) ──────────────────────────────────────
# Gmail: active la verificacion en dos pasos y genere una "contrasena de
# aplicacion" en https://myaccount.google.com/apppasswords
# NO sirve la contrasena normal de la cuenta.
SMTP_HOST=""
SMTP_PUERTO=587
# Se deduce del puerto si se deja vacio: 465 -> true, cualquier otro -> false.
SMTP_SEGURO=""
SMTP_USUARIO=""
SMTP_CLAVE="

# Solo para desarrollo: devuelve el codigo en la respuesta HTTP para no tener
# que mirar el log. Con NODE_ENV=production el servidor se niega a arrancar si
# esto esta en true.
CORREO_REVELAR_CODIGO="true"

CODIGO_VIGENCIA_MINUTOS=15
