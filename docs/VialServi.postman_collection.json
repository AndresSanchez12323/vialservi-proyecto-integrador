          }
        },
        {
          "name": "POST /clientes · crear",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCentral}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"documento\": \"10203040\",\n  \"nombre\": \"Cliente de prueba Postman\",\n  \"telefono\": \"3001234567\",\n  \"correo\": \"prueba@correo.com\"\n}" },
            "url": { "raw": "{{base}}/clientes", "host": ["{{base}}"], "path": ["clientes"] },
            "description": "Repetir esta petición debe dar 409: el documento es único."
          }
        },
        {
          "name": "PUT /clientes/:id · actualizar",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCentral}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"telefono\": \"3009998877\"\n}" },
            "url": { "raw": "{{base}}/clientes/{{clienteId}}", "host": ["{{base}}"], "path": ["clientes", "{{clienteId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Vehículo e inventario",
      "item": [
        {
          "name": "GET /vehiculos · todos (central)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCentral}}" }],
            "url": {
              "raw": "{{base}}/vehiculos?placa=",
              "host": ["{{base}}"],
              "path": ["vehiculos"],
              "query": [{ "key": "placa", "value": "", "description": "filtro opcional por placa" }]
            }
          }
        },
        {
          "name": "POST /vehiculos · el cliente registra el suyo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"placa\": \"PST100\",\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla Cross\",\n  \"color\": \"Plateado\",\n  \"clienteId\": 999999\n}" },
            "url": { "raw": "{{base}}/vehiculos", "host": ["{{base}}"], "path": ["vehiculos"] },
            "description": "Se manda a propósito un clienteId ajeno: el servidor lo ignora y pone el de la sesión."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 y queda a nombre del que inicio sesion', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().clienteId).to.not.eql(999999);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "✗ POST /vehiculos · placa repetida",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCentral}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"placa\": \"ABC123\",\n  \"marca\": \"Mazda\",\n  \"modelo\": \"CX-5\",\n  \"color\": \"Negro\",\n  \"clienteId\": {{clienteId}}\n}" },
            "url": { "raw": "{{base}}/vehiculos", "host": ["{{base}}"], "path": ["vehiculos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('409 placa repetida', () => pm.response.to.have.status(409));"] }
            }
          ]
        },
        {
          "name": "✗ POST /vehiculos · como técnico",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenTecnico}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"placa\": \"ZZZ999\",\n  \"marca\": \"Kia\",\n  \"modelo\": \"Picanto\",\n  \"color\": \"Rojo\",\n  \"clienteId\": {{clienteId}}\n}" },
            "url": { "raw": "{{base}}/vehiculos", "host": ["{{base}}"], "path": ["vehiculos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('403', () => pm.response.to.have.status(403));"] }
            }
          ]
        },
        {
          "name": "GET /vehiculos/:id · detalle con inventario",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCentral}}" }],
            "url": { "raw": "{{base}}/vehiculos/{{vehiculoId}}", "host": ["{{base}}"], "path": ["vehiculos", "{{vehiculoId}}"] }
          }
        },
