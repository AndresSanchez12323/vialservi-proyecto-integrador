{
  "info": {
    "name": "VialServi · API",
    "description": "Colección de pruebas del API de VialServi.\n\nORDEN: ejecute primero la carpeta '1. Acceso' (guarda los tokens de cada rol) y luego '2. Datos base' (guarda los ids que usan las demás peticiones). De ahí en adelante puede correr cualquier carpeta.\n\nLas peticiones marcadas con ✗ son las que DEBEN fallar: comprueban que el servidor impide lo que no se debe permitir.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:4000/api" },
    { "key": "clave", "value": "VialServi2026" },
    { "key": "tokenCentral", "value": "" },
    { "key": "tokenTecnico", "value": "" },
    { "key": "tokenCliente", "value": "" },
    { "key": "tokenAdmin", "value": "" },
    { "key": "clienteId", "value": "" },
    { "key": "vehiculoId", "value": "" },
    { "key": "tecnicoId", "value": "" },
    { "key": "servicioId", "value": "" },
    { "key": "expedienteId", "value": "" },
    { "key": "expedienteCerradoId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Salud",
      "item": [
        {
          "name": "GET /salud · el API responde",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base}}/salud", "host": ["{{base}}"], "path": ["salud"] },
            "description": "Única ruta sin token. Sirve para saber si el servidor está arriba."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y estado ok', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().estado).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Acceso",
      "item": [
        {
          "name": "POST /auth/login · central (2001)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"documento\": \"2001\",\n  \"clave\": \"{{clave}}\"\n}" },
            "url": { "raw": "{{base}}/auth/login", "host": ["{{base}}"], "path": ["auth", "login"] },
            "description": "Guarda el token en la variable tokenCentral."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('entra y devuelve token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const c = pm.response.json();",
                  "  pm.expect(c.token).to.be.a('string');",
                  "  pm.expect(c.usuario.rol).to.eql('CENTRAL');",
                  "  pm.collectionVariables.set('tokenCentral', c.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login · técnico (3001)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"documento\": \"3001\",\n  \"clave\": \"{{clave}}\"\n}" },
            "url": { "raw": "{{base}}/auth/login", "host": ["{{base}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('entra como TECNICO', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const c = pm.response.json();",
                  "  pm.expect(c.usuario.rol).to.eql('TECNICO');",
                  "  pm.collectionVariables.set('tokenTecnico', c.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login · cliente (71234567)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"documento\": \"71234567\",\n  \"clave\": \"{{clave}}\"\n}" },
            "url": { "raw": "{{base}}/auth/login", "host": ["{{base}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('entra como CLIENTE', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const c = pm.response.json();",
                  "  pm.expect(c.usuario.rol).to.eql('CLIENTE');",
                  "  pm.collectionVariables.set('tokenCliente', c.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login · administrador (1001)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"documento\": \"1001\",\n  \"clave\": \"{{clave}}\"\n}" },
            "url": { "raw": "{{base}}/auth/login", "host": ["{{base}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('entra como ADMINISTRADOR', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.collectionVariables.set('tokenAdmin', pm.response.json().token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "✗ POST /auth/login · clave incorrecta",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"documento\": \"2001\",\n  \"clave\": \"equivocada\"\n}" },
            "url": { "raw": "{{base}}/auth/login", "host": ["{{base}}"], "path": ["auth", "login"] },
            "description": "Debe dar 401 con el mismo mensaje que un documento inexistente: no se revela si el usuario existe."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "✗ GET /servicios · sin token",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base}}/servicios", "host": ["{{base}}"], "path": ["servicios"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 sin token', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "GET /auth/yo · quién soy",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCentral}}" }],
            "url": { "raw": "{{base}}/auth/yo", "host": ["{{base}}"], "path": ["auth", "yo"] }
          }
        }
      ]
    },
    {
      "name": "2. Datos base (guarda los ids)",
      "item": [
        {
          "name": "GET /clientes · guarda clienteId",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCentral}}" }],
            "url": { "raw": "{{base}}/clientes", "host": ["{{base}}"], "path": ["clientes"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('lista de clientes', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const l = pm.response.json();",
                  "  pm.expect(l.length).to.be.above(0);",
                  "  pm.collectionVariables.set('clienteId', l[0].id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /tecnicos · guarda tecnicoId",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCentral}}" }],
            "url": { "raw": "{{base}}/tecnicos", "host": ["{{base}}"], "path": ["tecnicos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('hay un tecnico de mecanica disponible', function () {",
                  "  const apto = pm.response.json().find(t => t.disponible && t.especialidades.includes('MECANICA'));",
                  "  pm.expect(apto, 'ningun tecnico apto').to.not.be.undefined;",
                  "  pm.collectionVariables.set('tecnicoId', apto.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /vehiculos · como cliente, guarda vehiculoId",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCliente}}" }],
            "url": { "raw": "{{base}}/vehiculos", "host": ["{{base}}"], "path": ["vehiculos"] },
            "description": "El cliente solo recibe sus vehículos: el filtro es del servidor."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('solo los vehiculos del cliente', function () {",
                  "  const l = pm.response.json();",
                  "  pm.expect(l.length).to.be.above(0);",
                  "  const dueno = l[0].cliente.id;",
                  "  pm.expect(l.every(v => v.cliente.id === dueno)).to.be.true;",
                  "  pm.collectionVariables.set('vehiculoId', l[0].id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /servicios · guarda servicioId y expedienteId",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCentral}}" }],
            "url": { "raw": "{{base}}/servicios", "host": ["{{base}}"], "path": ["servicios"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const l = pm.response.json();",
                  "const solicitado = l.find(s => s.estado === 'SOLICITADO');",
                  "if (solicitado) pm.collectionVariables.set('servicioId', solicitado.id);",
                  "const abierto = l.find(s => s.expediente && !s.expediente.cerradoEn);",
                  "if (abierto) pm.collectionVariables.set('expedienteId', abierto.expediente.id);",
                  "const cerrado = l.find(s => s.expediente && s.expediente.cerradoEn);",
                  "if (cerrado) pm.collectionVariables.set('expedienteCerradoId', cerrado.expediente.id);",
                  "pm.test('hay un servicio solicitado para clasificar', () => pm.expect(solicitado).to.not.be.undefined);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Cliente",
      "item": [
        {
          "name": "GET /clientes · directorio (central)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCentral}}" }],
            "url": { "raw": "{{base}}/clientes", "host": ["{{base}}"], "path": ["clientes"] }
          }
        },
        {
          "name": "✗ GET /clientes · como cliente",
