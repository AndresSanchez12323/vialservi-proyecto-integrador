            ],
            "body": { "mode": "raw", "raw": "{\n  \"vehiculoId\": {{vehiculoId}},\n  \"direccion\": \"Carrera 70 con calle 44\",\n  \"descripcion\": \"El vehículo no enciende\"\n}" },
            "url": { "raw": "{{base}}/servicios", "host": ["{{base}}"], "path": ["servicios"] },
            "description": "No se manda clienteId: sale de la sesión. Nace SOLICITADO, sin tipo y sin técnico."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('nace solicitado, sin clasificar', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const s = pm.response.json();",
                  "  pm.expect(s.estado).to.eql('SOLICITADO');",
                  "  pm.expect(s.tipo).to.be.null;",
                  "  pm.expect(s.tecnico).to.be.null;",
                  "  pm.collectionVariables.set('servicioId', s.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "✗ POST /servicios · vehículo de otro cliente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"vehiculoId\": 1,\n  \"direccion\": \"Carrera 70 con calle 44\",\n  \"descripcion\": \"Intento indebido\"\n}" },
            "url": { "raw": "{{base}}/servicios", "host": ["{{base}}"], "path": ["servicios"] },
            "description": "Ponga en vehiculoId el id de un vehículo que NO sea del cliente 71234567 (mírelo con GET /vehiculos como central). Debe responder 409."
          }
        },
        {
          "name": "PATCH /servicios/:id/clasificar · nace el expediente",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCentral}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"tipo\": \"CARRO_TALLER\",\n  \"tecnicoId\": {{tecnicoId}}\n}" },
            "url": { "raw": "{{base}}/servicios/{{servicioId}}/clasificar", "host": ["{{base}}"], "path": ["servicios", "{{servicioId}}", "clasificar"] },
            "description": "tipo: GRUA | CARRO_TALLER | CONDUCTOR_ELEGIDO. Al clasificar se crea el expediente en la misma transacción."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('queda asignado y con expediente', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const s = pm.response.json();",
                  "  pm.expect(s.estado).to.eql('ASIGNADO');",
                  "  pm.expect(s.expediente.consecutivo).to.match(/^EXP-/);",
                  "  pm.collectionVariables.set('expedienteId', s.expediente.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "✗ PATCH /servicios/:id/clasificar · como técnico",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenTecnico}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"tipo\": \"GRUA\",\n  \"tecnicoId\": {{tecnicoId}}\n}" },
            "url": { "raw": "{{base}}/servicios/{{servicioId}}/clasificar", "host": ["{{base}}"], "path": ["servicios", "{{servicioId}}", "clasificar"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('403', () => pm.response.to.have.status(403));"] }
            }
          ]
        },
        {
          "name": "PATCH /servicios/:id/estado · iniciar atención",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenTecnico}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"EN_EJECUCION\"\n}" },
            "url": { "raw": "{{base}}/servicios/{{servicioId}}/estado", "host": ["{{base}}"], "path": ["servicios", "{{servicioId}}", "estado"] },
            "description": "Solo acepta EN_EJECUCION o TERMINADO. CERRADO no: eso es del cierre del expediente."
          }
        },
        {
          "name": "PATCH /servicios/:id/estado · marcar terminado",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenTecnico}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"TERMINADO\"\n}" },
            "url": { "raw": "{{base}}/servicios/{{servicioId}}/estado", "host": ["{{base}}"], "path": ["servicios", "{{servicioId}}", "estado"] }
          }
        },
        {
          "name": "✗ PATCH /servicios/:id/cancelar · sin motivo",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCentral}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"motivo\": \"\"\n}" },
            "url": { "raw": "{{base}}/servicios/{{servicioId}}/cancelar", "host": ["{{base}}"], "path": ["servicios", "{{servicioId}}", "cancelar"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('400 exige motivo', () => pm.response.to.have.status(400));"] }
            }
          ]
        },
        {
          "name": "PATCH /servicios/:id/cancelar · con motivo",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCentral}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"motivo\": \"El cliente logró encender el vehículo\"\n}" },
            "url": { "raw": "{{base}}/servicios/{{servicioId}}/cancelar", "host": ["{{base}}"], "path": ["servicios", "{{servicioId}}", "cancelar"] },
            "description": "OJO: esto cancela el servicio que venía usando. Déjelo de último, o use otro servicioId."
          }
        },
        {
          "name": "GET /servicios/:id · detalle",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCentral}}" }],
            "url": { "raw": "{{base}}/servicios/{{servicioId}}", "host": ["{{base}}"], "path": ["servicios", "{{servicioId}}"] }
          }
        }
      ]
    },
    {
      "name": "7. Expediente",
      "item": [
        {
          "name": "GET /expedientes/:id · todo el expediente",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCentral}}" }],
            "url": { "raw": "{{base}}/expedientes/{{expedienteId}}", "host": ["{{base}}"], "path": ["expedientes", "{{expedienteId}}"] },
            "description": "Trae servicio, cliente, vehículo con inventario, técnico, evidencias (ordenadas por hora de captura) y novedades."
          }
        },
        {
          "name": "PATCH /expedientes/:id/observaciones · campo del técnico",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenTecnico}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"observaciones\": \"Se encontró la batería descargada y se hizo puente.\",\n  \"version\": 1\n}" },
            "url": { "raw": "{{base}}/expedientes/{{expedienteId}}/observaciones", "host": ["{{base}}"], "path": ["expedientes", "{{expedienteId}}", "observaciones"] },
            "description": "La versión debe ser mayor que la guardada. Si manda una menor o igual, la respuesta trae descartado: true — así una edición vieja que llega tarde no pisa la nueva."
          }
        },
        {
          "name": "PATCH /expedientes/:id/observaciones · versión vieja (se descarta)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenTecnico}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"observaciones\": \"Texto viejo que llega tarde\",\n  \"version\": 1\n}" },
            "url": { "raw": "{{base}}/expedientes/{{expedienteId}}/observaciones", "host": ["{{base}}"], "path": ["expedientes", "{{expedienteId}}", "observaciones"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 pero descartado, no pisa el texto nuevo', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().descartado).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /expedientes/:id/evidencias · el técnico sube una foto",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenTecnico}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"idLocal\": \"postman-foto-001\",\n  \"tipo\": \"FOTO\",\n  \"archivo\": \"evidencias/postman-001.jpg\",\n  \"tomadaEn\": \"2026-09-21T14:30:00.000Z\"\n}" },
            "url": { "raw": "{{base}}/expedientes/{{expedienteId}}/evidencias", "host": ["{{base}}"], "path": ["expedientes", "{{expedienteId}}", "evidencias"] },
            "description": "tipo: FOTO | VIDEO. El idLocal es la llave que genera el dispositivo."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('201 la primera vez', () => pm.response.to.have.status(201));"] }
            }
          ]
        },
        {
          "name": "POST /expedientes/:id/evidencias · el mismo idLocal (reintento)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenTecnico}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"idLocal\": \"postman-foto-001\",\n  \"tipo\": \"FOTO\",\n  \"archivo\": \"evidencias/postman-001.jpg\"\n}" },
            "url": { "raw": "{{base}}/expedientes/{{expedienteId}}/evidencias", "host": ["{{base}}"], "path": ["expedientes", "{{expedienteId}}", "evidencias"] },
            "description": "Es la prueba del trabajo sin señal: el reintento se reconoce, no se duplica."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, no 201: reconocida y no duplicada', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /expedientes/:id/evidencias · la sube el cliente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"idLocal\": \"postman-cliente-001\",\n  \"tipo\": \"FOTO\",\n  \"archivo\": \"evidencias/postman-cliente.jpg\"\n}" },
            "url": { "raw": "{{base}}/expedientes/{{expedienteId}}/evidencias", "host": ["{{base}}"], "path": ["expedientes", "{{expedienteId}}", "evidencias"] },
            "description": "Queda con subidaPor.rol = CLIENTE: así se distingue de la del técnico."
          }
        },
        {
          "name": "POST /expedientes/:id/evidencias · a un expediente ya cerrado",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenTecnico}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"idLocal\": \"postman-tardia-001\",\n  \"tipo\": \"FOTO\",\n  \"archivo\": \"evidencias/postman-tardia.jpg\"\n}" },
            "url": { "raw": "{{base}}/expedientes/{{expedienteCerradoId}}/evidencias", "host": ["{{base}}"], "path": ["expedientes", "{{expedienteCerradoId}}", "evidencias"] },
            "description": "No se rechaza: se guarda con posteriorAlCierre = true."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 y marcada como posterior al cierre', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().posteriorAlCierre).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /expedientes/:id/novedades",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenTecnico}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"idLocal\": \"postman-novedad-001\",\n  \"descripcion\": \"El cliente no estaba en el sitio a la llegada.\"\n}" },
            "url": { "raw": "{{base}}/expedientes/{{expedienteId}}/novedades", "host": ["{{base}}"], "path": ["expedientes", "{{expedienteId}}", "novedades"] }
          }
        },
        {
          "name": "✗ POST /expedientes/:id/cerrar · como técnico",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenTecnico}}" }],
            "url": { "raw": "{{base}}/expedientes/{{expedienteId}}/cerrar", "host": ["{{base}}"], "path": ["expedientes", "{{expedienteId}}", "cerrar"] },
            "description": "403: quien presta el servicio no declara cerrada la evidencia de que existió."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('403', () => pm.response.to.have.status(403));"] }
            }
          ]
        },
        {
          "name": "POST /expedientes/:id/cerrar · la central cierra",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCentral}}" }],
            "url": { "raw": "{{base}}/expedientes/{{expedienteId}}/cerrar", "host": ["{{base}}"], "path": ["expedientes", "{{expedienteId}}", "cerrar"] },
            "description": "Exige que el servicio esté TERMINADO y que haya al menos una evidencia. Si no, 409. Repetirlo también da 409."
          }
        }
      ]
    },
    {
      "name": "8. Históricos y reportes",
      "item": [
        {
          "name": "GET /reportes/indicadores",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCentral}}" }],
            "url": { "raw": "{{base}}/reportes/indicadores", "host": ["{{base}}"], "path": ["reportes", "indicadores"] }
          }
        },
        {
          "name": "✗ GET /reportes/indicadores · como técnico",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenTecnico}}" }],
            "url": { "raw": "{{base}}/reportes/indicadores", "host": ["{{base}}"], "path": ["reportes", "indicadores"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('403', () => pm.response.to.have.status(403));"] }
            }
          ]
        },
        {
          "name": "GET /reportes/historial?placa=ABC123",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenCentral}}" }],
            "url": {
              "raw": "{{base}}/reportes/historial?placa=ABC123",
              "host": ["{{base}}"],
              "path": ["reportes", "historial"],
              "query": [{ "key": "placa", "value": "ABC123" }]
            },
            "description": "La consulta que resuelve una reclamación meses después."
          }
        }
      ]
    },
    {
      "name": "9. Pendiente",
      "item": [
        {
          "name": "GET /usuarios · módulo no implementado",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
            "url": { "raw": "{{base}}/usuarios", "host": ["{{base}}"], "path": ["usuarios"] },
            "description": "501 a propósito: la navegación y el API dicen lo mismo, el módulo está declarado pero no construido."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('501 no implementado', () => pm.response.to.have.status(501));"] }
            }
          ]
        }
      ]
    }
  ]
