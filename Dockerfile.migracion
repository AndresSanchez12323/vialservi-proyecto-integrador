FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache postgresql16-client ca-certificates \
 && wget -q https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem -O /app/rds-ca.pem
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --omit=dev --workspace apps/api --include-workspace-root
COPY infra/migrar-aurora.mjs ./migrar-aurora.mjs
USER node
CMD ["node", "migrar-aurora.mjs"]
